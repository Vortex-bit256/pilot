DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM provider id (see src/core/llm/providers/)
# AGENT_PROVIDER=deepseek
# deepseek-chat (V3) or deepseek-reasoner (R1)
AGENT_MODEL=deepseek-chat
AGENT_MAX_ITERATIONS=20
# Verbose debug logs to stderr: every agent event (same as --debug)
# AGENT_DEBUG=0
# Token streaming (live output); set to 0 to wait for full LLM responses
# AGENT_STREAMING=1
# Permission mode: safe (approve writes+commands), work (approve commands), free (approve nothing)
# AGENT_MODE=safe

